# AutoDBA Environment Configuration Template
PROJECT_NAME=AutoDBA
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autodba
POSTGRES_USER=autodba
POSTGRES_PASSWORD=autodba

# Application Database URL (Optional override; defaults to postgresql+psycopg://user:password@host:port/db)
DATABASE_URL=postgresql+psycopg://autodba:autodba@postgres:5432/autodba

# AI Reasoning Configuration (Groq Llama 3.3 70B)
# Loaded server-side only; never exposed to frontend
GROQ_API_KEY=your_groq_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://backend:8000
