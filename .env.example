# AutoDBA Environment Configuration Template
PROJECT_NAME=AutoDBA
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autodba
POSTGRES_USER=autodba
POSTGRES_PASSWORD=autodba

# Application Database URL (Optional override; defaults to postgresql+psycopg://user:password@host:port/db)
DATABASE_URL=postgresql+psycopg://autodba:autodba@postgres:5432/autodba
